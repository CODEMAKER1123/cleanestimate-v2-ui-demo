{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "admin-redesign/**",
              "field-app/**",
              "mobile_app/**",
              "sales_mode/**",
              "simple/**",
              "ui_kits/admin/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: DM Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminSidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|user|key|ref|className|style|children)$/]",
        "message": "<AdminSidebar> doesn't accept that prop. Declared props: active, onNavigate, user."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminTopbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:breadcrumbs|title|actions|key|ref|className|style|children)$/]",
        "message": "<AdminTopbar> doesn't accept that prop. Declared props: breadcrumbs, title, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureDetail'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|desc|bullets|img|flip|key|ref|className|style|children)$/]",
        "message": "<FeatureDetail> doesn't accept that prop. Declared props: title, eyebrow, desc, bullets, img, flip."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarketingNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:onNavigate|active|key|ref|className|style|children)$/]",
        "message": "<MarketingNav> doesn't accept that prop. Declared props: onNavigate, active."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
